# 复制成 wrangler.toml 再填自己的值。
# wrangler.toml 已加入 .gitignore，避免把 KV id / 域名提交到公开仓库。

name = "bili-302"
main = "worker.mjs"
compatibility_date = "2024-11-01"

# ── 绑定自己的域名（二选一，同时写会冲突）──

# A) 整域名（DNS 在同一个 Cloudflare 账号下，推荐）
# [[routes]]
# pattern = "bili.example.com"
# custom_domain = true

# B) 挂在某个域名的子路径下
# [[routes]]
# pattern = "example.com/bili/*"
# zone_name = "example.com"

[vars]
# 仅 B 方案需要
# BASE_PATH = "/bili"

# ── 推送缓存用的 KV ──
#   npx wrangler kv namespace create PUSH
# 把输出的 id 填进来
# [[kv_namespaces]]
# binding = "PUSH"
# id = "<your-kv-namespace-id>"

# ── /push 保护（推荐）──
# 用 secret 而不是写在这里：
#   npx wrangler secret put PUSH_TOKEN

# 可选：关闭「按 ASN 自动探测最佳 CDN 节点」（默认开启）
# CDN_LEARN = "0"

# 冷启动（KV 未命中）回给客户端的总预算，默认 9000ms。
# 如果上游 bilibili 从你的 Worker 出口很慢、但你愿意让播放器等，调大这个值：
# COLD_BUDGET_MS = "15000"

# 可选：让 Worker 尽量靠近源站（bilibili）而不是靠近用户。
# 冷启动更快，但每次 302 的往返会远一点——本项目响应很小，通常值得。
# [placement]
# mode = "smart"
